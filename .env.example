# Environment configuration example
# Copy this to .env and fill in your actual values

GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finmind_db

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development

# API Rate Limiting
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=INFO


# Replace with a cryptographically random secret of at least 32 bytes outside development.
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# false is for local/demo development only; production requires authentication.
AUTH_REQUIRED=false
